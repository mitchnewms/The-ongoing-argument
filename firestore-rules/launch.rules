rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // One record per argument: the first keeps the account id; a later one is the account id, an underscore
    // and the argument id. Only that person (or the coach, for reading) may use them.
    function ownsDoc(id) { return id == me() || id.matches(me() + '_.*'); }
    function coachOrOwnsDoc(id) { return isCoach() || ownsDoc(id); }
    function isCoach() {
      return signedIn() && request.auth.token.email == 'mitch@mitchnewman.com';
    }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function coupleData(cid) { return get(/databases/$(database)/documents/couples/$(cid)).data; }
    function inCouple(c, uid) {
      return c.partnerAId == uid || c.get('partnerBId', '') == uid;
    }
    // Both people are members of the same couple record, and each person's own
    // profile names that couple. A stranger cannot satisfy this without having
    // joined the couple through its one-time join code.
    function sameCouple(other) {
      let cid = userData(me()).get('coupleId', '');
      return other != me()
        && cid != ''
        && userData(other).get('coupleId', '') == cid
        && inCouple(coupleData(cid), me())
        && inCouple(coupleData(cid), other);
    }

    // ---------- profiles ----------
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isCoach() || sameCouple(uid));
      allow create, update: if signedIn() && (me() == uid || isCoach());
      allow delete: if false;
    }

    // ---------- the couple record (shared by both partners) ----------
    match /couples/{cid} {
      allow read: if signedIn() && (isCoach() || inCouple(resource.data, me()));
      // LAUNCH RULES: a browser can never write the payment fields. Only the server (service
      // account, which bypasses these rules) records paidStatus, coupleCode and paidAt.
      allow create: if signedIn()
        && request.resource.data.partnerAId == me()
        && request.resource.data.get('partnerBId', '') == ''
        && !request.resource.data.keys().hasAny(PAID_FIELDS());
      allow update: if signedIn() && (isCoach() || memberUpdate() || joinUpdate())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(PAID_FIELDS());
      allow delete: if false;

      function PAID_FIELDS() { return ['paidStatus', 'coupleCode', 'paidAt', 'partnerAConfirmed']; }
      function memberUpdate() {
        return inCouple(resource.data, me())
          && request.resource.data.partnerAId == resource.data.partnerAId
          && request.resource.data.get('partnerBId', '') == resource.data.get('partnerBId', '');
      }
      function joinUpdate() {
        return !inCouple(resource.data, me())
          && resource.data.get('partnerBId', '') == ''
          && request.resource.data.partnerBId == me()
          && request.resource.data.partnerAId == resource.data.partnerAId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerBId', 'partnerBConfirmed']);
      }
    }

    // ---------- public join lookup (readable before login, one code at a time) ----------
    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      // LAUNCH RULES: join codes are created by the server after payment, never by a browser.
      allow create: if false;
      allow update: if signedIn() && (
        (resource.data.partnerAId == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']))
        || (resource.data.get('used', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
            && request.resource.data.used == true));
      allow delete: if false;
    }

    // ---------- private to one person ----------
    // The saved interview answers (and the retelling, once it is switched on) live here. Never readable by a partner.
    match /private/{uid} {
      allow read: if signedIn() && coachOrOwnsDoc(uid);
      allow write: if signedIn() && ownsDoc(uid);
    }

    // Scripts, intake answers and story answers: owner only. The joint analysis and the Step 3 conversation
    // run on the server, so a partner's browser never needs to read this.
    match /scripts/{uid} {
      allow read: if signedIn() && (ownsDoc(uid) || isCoach());
      allow write: if signedIn() && ownsDoc(uid);
    }

    // The shared copy of a script (the lines, the scene, the name of the fight and the names, nothing else).
    // It is written only by the server, at the one sharing moment when a person continues from Step 4 to Step 5.
    // A linked partner can read it once they have shared their own, so the sharing is always both ways.
    match /sharedScripts/{uid} {
      allow read: if signedIn() && (me() == uid || isCoach()
        || (sameCouple(uid) && exists(/databases/$(database)/documents/sharedScripts/$(me()))));
      allow write: if false;
    }

    // Everything else that belongs to one person.
    match /{col}/{uid} {
      allow read: if signedIn()
        && col in ['warmup', 'step3', 'step4', 'step5', 'step6', 'step7', 'step8', 'step11', 'practice', 'solo-analysis']
        && coachOrOwnsDoc(uid);
      allow write: if signedIn()
        && col in ['warmup', 'step3', 'step4', 'step5', 'step6', 'step7', 'step8', 'step11', 'practice', 'solo-analysis']
        && ownsDoc(uid);
    }

    // ---------- coach notes: coach writes, the person reads their own ----------
    match /notes/{id} {
      allow read: if signedIn() && (isCoach() || resource.data.userId == me());
      allow create, update, delete: if isCoach();
    }

    // ---------- awareness log: owner only ----------
    match /awarenessLog/{id} {
      allow read: if signedIn() && (isCoach() || resource.data.userId == me());
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && resource.data.userId == me() && request.resource.data.userId == me();
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // ---------- feedback, safety flags, coach interest ----------
    match /feedback/{uid} {
      allow create, update: if signedIn() && me() == uid;
      allow read: if isCoach();
    }
    match /coachFlags/{id} {
      allow create: if signedIn() && request.resource.data.triggeredByUid == me();
      allow read: if isCoach();
      allow update, delete: if false;
    }
    match /coachInterest/{id} {
      allow create: if signedIn();
      allow read: if isCoach();
      allow update, delete: if false;
    }
  }
}
